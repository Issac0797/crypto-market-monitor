[Unit]
Description=Crypto Market Monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=cmm
Group=cmm
WorkingDirectory=/var/lib/crypto-market-monitor
StateDirectory=crypto-market-monitor
StateDirectoryMode=0700
RuntimeDirectory=crypto-market-monitor
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/crypto-market-monitor/telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/crypto-market-monitor/current/venv/bin/python -m crypto_market_monitor.risk_watch_cli --config /etc/crypto-market-monitor/config.toml --state-dir /var/lib/crypto-market-monitor --telegram
Restart=always
RestartSec=15
WatchdogSec=90
TimeoutStartSec=90
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LimitCORE=0
MemoryAccounting=true
MemoryHigh=144M
MemoryMax=192M
CPUQuota=20%
Nice=10
TasksMax=24
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=1h
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
