[Unit]
Description=Crypto Market Monitor Bot B 24/7 BTC/ETH market risk (no trading)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=cqlbotb
Group=cqlbotb
WorkingDirectory=/var/lib/cql-bot-b
StateDirectory=cql-bot-b
StateDirectoryMode=0700
RuntimeDirectory=cql-bot-b
RuntimeDirectoryMode=0700
EnvironmentFile=/etc/cql-bot-b/telegram.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/cql-bot-b/current/venv/bin/python -m crypto_market_monitor.risk_watch_cli --config /etc/cql-bot-b/config.toml --state-dir /var/lib/cql-bot-b --telegram
Restart=always
RestartSec=15
WatchdogSec=90
TimeoutStartSec=90
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LimitCORE=0
MemoryAccounting=true
MemoryHigh=144M
MemoryMax=192M
CPUQuota=20%
Nice=10
TasksMax=24
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=1h
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target
